# Einstellungen von Soll (https://soll.work/installation.html). Als soll.env kopieren und ausfüllen;
# soll.env enthält den Schlüssel und gehört weder ins Git noch in eine Sicherung neben der Datenbank.

# Pflicht: 32 Zufallsbytes in Base64, einmal erzeugen mit `openssl rand -base64 32` und aufbewahren.
# Ohne startet Soll nicht; eine Sicherung lässt sich nur mit demselben Schlüssel wieder starten.
SOLL_SECRET_KEY=

# Adresse, unter der Soll erreichbar ist (Einladungslinks, Passkeys, Prüfseite auf dem Stundenzettel)
SOLL_URL=https://soll.example.de

# Optional: Mail über SMTP, beide oder keins
# SOLL_SMTP_URL=smtps://soll:passwort@mail.example.de:465
# SOLL_MAIL_VON=Soll <soll@example.de>
