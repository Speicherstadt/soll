{
  "name": "soll",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate": "paraglide-js compile --silent --project ./project.inlang --outdir ./apps/web/src/paraglide --strategy localStorage cookie preferredLanguage baseLocale",
    "typecheck": "bun run generate && tsc -b",
    "lint": "biome check --error-on-warnings .",
    "solid2": "bun scripts/solid2.ts",
    "format": "biome check --write .",
    "test": "bun --bun vitest run",
    "build": "bun scripts/build-all.ts",
    "e2e": "playwright test --trace off",
    "gesetze": "bun scripts/gesetze/gesetze.ts",
    "lasttest": "BUN_CONFIG_MAX_HTTP_REQUESTS=4096 bun apps/server/src/lasttest/main.ts",
    "db:generate": "bun run --cwd apps/server drizzle-kit generate && bun scripts/migrationen.ts",
    "check": "bun run typecheck && bun run lint && bun run solid2 && bun run test && bun run build",
    "dev:server": "SOLL_PORT=18200 bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "@playwright/test": "1.65.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
